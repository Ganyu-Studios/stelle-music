{
    "name": "stelle-music",
    "version": "0.3.9-BLAZER",
    "description": "A music bot.",
    "main": "./dist/index.js",
    "type": "module",
    "packageManager": "pnpm@10.32.0+sha512.9b2634bb3fed5601c33633f2d92593f506270a3963b8c51d2b2d6a828da615ce4e9deebef9614ccebbc13ac8d3c0f9c9ccceb583c69c8578436fa477dbb20d70",
    "homepage": "https://github.com/Ganyu-Studios/stelle-music#readme",
    "author": "Ganyu Studios",
    "license": "MIT",
    "keywords": [
        "discord",
        "discord.js",
        "seyfert",
        "music",
        "bot",
        "discord bot",
        "stelle",
        "lavalink"
    ],
    "contributors": [
        {
            "name": "JustEvil",
            "url": "https://github.com/EvilG-MC"
        }
    ],
    "engines": {
        "node": ">= 22.11.0",
        "pnpm": ">= 10.7.0"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "clean": "node ./scripts/clean.mjs && pnpm build",
        "start": "node ./dist/index.js",
        "dev": "tsx ./src/index.ts --debug --dev",
        "lint": "biome lint --write .",
        "format": "biome check --write .",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db": "pnpm db:push && pnpm db:generate",
        "prepare": "husky"
    },
    "lint-staged": {
        "{*.ts,*.json}": [
            "pnpm format"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ganyu-Studios/stelle-music.git"
    },
    "bugs": {
        "url": "https://github.com/Ganyu-Studios/stelle-music/issues"
    },
    "dependencies": {
        "@prisma/client": "^6.19.2",
        "@redis/client": "^5.11.0",
        "dotenv": "^17.3.1",
        "hoshimi": "0.3.10-dev-22742453932.0",
        "imagescript": "^1.3.1",
        "meowdb": "^2.2.3",
        "seyfert": "github:tiramisulabs/seyfert",
        "yunaforseyfert": "^1.1.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.6",
        "@types/node": "^25.4.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.3.2",
        "prisma": "^6.19.2",
        "tsx": "^4.21.0",
        "typescript": "^5.9.3"
    },
    "imports": {
        "#stelle/classes/*": "./dist/structures/classes/*",
        "#stelle/utils/*": "./dist/structures/utils/*",
        "#stelle/controllers/*": "./dist/structures/controllers/*",
        "#stelle/types": "./dist/structures/types/index.js",
        "#stelle/middlewares": "./dist/middlewares/index.js",
        "#stelle/prisma": "./dist/generated/prisma/client.js"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@biomejs/biome",
            "@prisma/client",
            "@prisma/engines",
            "esbuild",
            "prisma",
            "seyfert"
        ]
    }
}
