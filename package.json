{
    "name": "stelle-music",
    "version": "0.4.0-BLAZER",
    "description": "A music bot.",
    "main": "./src/index.ts",
    "type": "module",
    "homepage": "https://github.com/Ganyu-Studios/stelle-music#readme",
    "author": "Ganyu Studios",
    "license": "MIT",
    "keywords": [
        "discord",
        "discord.js",
        "seyfert",
        "music",
        "bot",
        "discord bot",
        "stelle",
        "lavalink"
    ],
    "contributors": [
        {
            "name": "JustEvil",
            "url": "https://github.com/EvilG-MC"
        }
    ],
    "engines": {
        "bun": ">= 1.4.4"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun test tests/",
        "start": "bun src/index.ts",
        "dev": "bun src/index.ts --debug --dev",
        "lint": "oxlint && eslint src",
        "lint:fix": "oxlint --fix && eslint src --fix",
        "lint:seyfert": "eslint src",
        "format": "oxfmt",
        "format:check": "oxfmt --check",
        "db:generate": "bunx --bun prisma generate",
        "db:push": "bunx --bun prisma db push",
        "db": "bun run db:push && bun run db:generate",
        "prepare": "husky"
    },
    "lint-staged": {
        "**/*.{js,jsx,ts,tsx,mjs,cjs}": [
            "oxlint --fix",
            "eslint --fix",
            "oxfmt"
        ],
        "**/*.{json,jsonc}": [
            "oxfmt"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ganyu-Studios/stelle-music.git"
    },
    "bugs": {
        "url": "https://github.com/Ganyu-Studios/stelle-music/issues"
    },
    "dependencies": {
        "@prisma/client": "6.19.3",
        "hoshimi": "0.6.2-dev-44409975731.0",
        "imagescript": "^4.0.1",
        "meowdb": "^2.2.3",
        "seyfert": "6.0.0",
        "yunaforseyfert": "^1.2.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@marcrock22/eslintcf": "^0.0.3",
        "@slipher/eslint-plugin": "^1.1.0",
        "@types/bun": "1.4.5",
        "@typescript/native": "npm:typescript@^7.0.2",
        "eslint": "^10.15.0",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.2",
        "oxfmt": "^0.80.0",
        "oxlint": "^1.95.0",
        "prisma": "6.19.3",
        "typescript": "npm:@typescript/typescript6@^6.0.2",
        "typescript-eslint": "^8.74.0"
    },
    "trustedDependencies": [
        "@prisma/client",
        "@prisma/engines",
        "prisma"
    ]
}
