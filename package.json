{
    "name": "stelle-music",
    "version": "0.4.0-BLAZER",
    "description": "A music bot.",
    "main": "./src/index.ts",
    "type": "module",
    "homepage": "https://github.com/Ganyu-Studios/stelle-music#readme",
    "author": "Ganyu Studios",
    "license": "MIT",
    "keywords": [
        "discord",
        "discord.js",
        "seyfert",
        "music",
        "bot",
        "discord bot",
        "stelle",
        "lavalink"
    ],
    "contributors": [
        {
            "name": "JustEvil",
            "url": "https://github.com/EvilG-MC"
        }
    ],
    "engines": {
        "bun": ">= 1.4.4"
    },
    "scripts": {
        "typecheck": "tsc --noEmit",
        "test": "bun test tests/",
        "start": "bun src/index.ts",
        "dev": "bun src/index.ts --debug --dev",
        "lint": "biome lint --write .",
        "format": "biome check --write .",
        "db:generate": "bunx --bun prisma generate",
        "db:push": "bunx --bun prisma db push",
        "db": "bun run db:push && bun run db:generate",
        "prepare": "husky"
    },
    "lint-staged": {
        "{*.ts,*.json}": [
            "bun run format"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ganyu-Studios/stelle-music.git"
    },
    "bugs": {
        "url": "https://github.com/Ganyu-Studios/stelle-music/issues"
    },
    "dependencies": {
        "@prisma/client": "6.19.3",
        "hoshimi": "0.6.0",
        "imagescript": "^3.20.2",
        "meowdb": "^2.2.3",
        "seyfert": "5.2.2-dev-41510346259.0",
        "yunaforseyfert": "^1.2.4",
        "zod": "^4.6.7"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.6.6",
        "@types/bun": "1.4.4",
        "husky": "^9.1.7",
        "lint-staged": "^17.6.0",
        "prisma": "6.19.3",
        "typescript": "^7.0.2"
    },
    "trustedDependencies": [
        "@prisma/client",
        "@prisma/engines",
        "prisma"
    ]
}
