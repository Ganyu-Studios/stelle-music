{
    "name": "stelle-music",
    "version": "0.4.0-BLAZER",
    "description": "A music bot.",
    "main": "./dist/index.js",
    "type": "module",
    "packageManager": "pnpm@10.33.2+sha512.a90faf6feeab71ad6c6e57f94e0fe1a12f5dcc22cd754db40ae9593eb6a3e0b6b12e3540218bb37ae083404b1f2ce6db2a4121e979829b4aff94b99f49da1cf8",
    "homepage": "https://github.com/Ganyu-Studios/stelle-music#readme",
    "author": "Ganyu Studios",
    "license": "MIT",
    "keywords": [
        "discord",
        "discord.js",
        "seyfert",
        "music",
        "bot",
        "discord bot",
        "stelle",
        "lavalink"
    ],
    "contributors": [
        {
            "name": "JustEvil",
            "url": "https://github.com/EvilG-MC"
        }
    ],
    "engines": {
        "node": ">= 22.11.0",
        "pnpm": ">= 10.7.0"
    },
    "scripts": {
        "build": "tsc",
        "typecheck": "tsc --noEmit",
        "clean": "node ./scripts/clean.mjs && pnpm build",
        "start": "node ./dist/index.js",
        "dev": "tsx ./src/index.ts --debug --dev",
        "lint": "biome lint --write .",
        "format": "biome check --write .",
        "db:generate": "prisma generate",
        "db:push": "prisma db push",
        "db": "pnpm db:push && pnpm db:generate",
        "prepare": "husky"
    },
    "lint-staged": {
        "{*.ts,*.json}": [
            "pnpm format"
        ]
    },
    "repository": {
        "type": "git",
        "url": "git+https://github.com/Ganyu-Studios/stelle-music.git"
    },
    "bugs": {
        "url": "https://github.com/Ganyu-Studios/stelle-music/issues"
    },
    "dependencies": {
        "@prisma/client": "^6.19.3",
        "@redis/client": "^5.12.1",
        "dotenv": "^17.4.2",
        "hoshimi": "0.3.10-dev-24955987735.0",
        "imagescript": "^1.3.1",
        "meowdb": "^2.2.3",
        "seyfert": "4.3.1-dev-24960926884.0",
        "yunaforseyfert": "^1.1.3",
        "zod": "^4.3.6"
    },
    "devDependencies": {
        "@biomejs/biome": "^2.4.13",
        "@types/node": "^25.6.0",
        "husky": "^9.1.7",
        "lint-staged": "^16.4.0",
        "prisma": "^6.19.3",
        "tsx": "^4.21.0",
        "typescript": "^6.0.3"
    },
    "imports": {
        "#stelle/classes/*": "./dist/structures/classes/*",
        "#stelle/utils/*": "./dist/structures/utils/*",
        "#stelle/controllers/*": "./dist/structures/controllers/*",
        "#stelle/types": "./dist/structures/types/index.js",
        "#stelle/middlewares": "./dist/middlewares/index.js",
        "#stelle/prisma": "./dist/generated/prisma/client.js"
    },
    "pnpm": {
        "onlyBuiltDependencies": [
            "@biomejs/biome",
            "@prisma/client",
            "@prisma/engines",
            "esbuild",
            "prisma",
            "seyfert"
        ]
    }
}
